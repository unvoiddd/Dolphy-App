language js(typescript)

// scope: global

// One snippet with the method as a metavariable matches the same calls as one snippet per
// method, and costs about half as much CPU on a full lint.
`Reflect.$method($args)` as $call where {
  $method <: or { `apply`, `get` },
  register_diagnostic(
    span=$call,
    message="Do not use Reflect to get past the type checker. Call the function directly or read the property directly, modelling dynamic dispatch behind a named interface and parsing dynamic input into a domain type first.",
    severity="error"
  )
}
