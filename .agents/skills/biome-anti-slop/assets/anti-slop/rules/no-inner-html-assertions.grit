language js(typescript)

// scope: tests

or {
  `expect($_.innerHTML)`,
  `expect($_.outerHTML)`
} as $node where {
  register_diagnostic(
    span=$node,
    message="Do not assert on raw HTML in tests. See the Tests section of AGENTS.md: assert the behaviour, or the text the user can actually see. Building a fixture with innerHTML stays fine.",
    severity="error"
  )
}
