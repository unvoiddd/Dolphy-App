import json

__id__ = "lan_scanner"
__name__ = "LAN Scanner"
__version__ = "1.0.0"
__author__ = "Dolphy"
__description__ = "Discover live hosts on the local subnet and scan their common TCP ports"
__icon__ = "rounded:lan"
__permissions__ = ["network"]

PORTS = [21, 22, 23, 53, 80, 139, 443, 445, 554, 631, 1883, 5000, 8008, 8080, 8443, 9100]


class LanScanner(BasePlugin):
    def __init__(self):
        super().__init__()
        self.base = ""
        self.range_text = "1-64"
        self.hosts = {}
        self.ports = {}
        self.selected = None
        self.scanning = False
        self.queue = []
        self.active = 0
        self.completed = 0
        self.total = 0
        self.status = "Ready"
        self.concurrency = 8

    def on_plugin_load(self):
        self.add_module(
            "LAN Scanner",
            "Live hosts on the local subnet and open TCP ports",
            "lan",
            "main",
            "OTHER",
            50,
        )
        self.base = self.detect_base()
        self.status = "Subnet " + self.base + "0/24" if self.base else "Set the subnet manually"

    def on_plugin_unload(self):
        self.stop_scan()

    def detect_base(self):
        try:
            info = json.loads(str(self.api.getAndroid().wifiDetailedInfoJson()))
            ip = str(info.get("ip", ""))
            if ip.count(".") == 3:
                return ip.rsplit(".", 1)[0] + "."
        except Exception:
            pass
        try:
            interfaces = json.loads(str(self.api.getAndroid().netInterfacesJson()))
            for interface in interfaces:
                for address in interface.get("addresses", []):
                    host = str(address.get("host", ""))
                    if address.get("ipv4") and not address.get("loopback") and host.count(".") == 3:
                        return host.rsplit(".", 1)[0] + "."
        except Exception:
            pass
        return ""

    def set_base(self, value):
        text = str(value).strip()
        if text and not text.endswith("."):
            text += "."
        self.base = text
        self.refresh()

    def set_range(self, value):
        self.range_text = str(value)
        self.refresh()

    def parse_range(self):
        text = str(self.range_text).replace(" ", "")
        try:
            if "-" in text:
                start, end = text.split("-", 1)
                first = int(start)
                last = int(end)
            else:
                first = int(text)
                last = first
        except Exception:
            return 1, 64
        first = max(1, min(254, first))
        last = max(first, min(254, last))
        return first, last

    def start_scan(self):
        first, last = self.parse_range()
        if not self.base or self.base.count(".") < 2:
            self.status = "Set a subnet such as 192.168.1."
            self.refresh()
            return
        self.hosts = {}
        self.ports = {}
        self.completed = 0
        self.queue = [self.base + str(octet) for octet in range(first, last + 1)]
        self.total = len(self.queue)
        self.scanning = True
        self.status = "Scanning " + str(self.total) + " addresses…"
        for _ in range(min(self.concurrency, len(self.queue))):
            self.launch_next()
        self.refresh()

    def launch_next(self):
        if not self.scanning or not self.queue:
            if self.scanning and self.active == 0:
                self.scanning = False
                self.status = "Scan complete · " + str(len(self.hosts)) + " live hosts"
                self.refresh()
            return
        host = self.queue.pop(0)
        self.active += 1

        def done(payload):
            self.active -= 1
            self.completed += 1
            try:
                result = json.loads(str(payload))
            except Exception:
                result = {}
            if result.get("ok"):
                self.hosts[host] = result
            self.status = "Scanning · " + str(self.completed) + "/" + str(self.total) + " · " + str(len(self.hosts)) + " live"
            self.launch_next()
            self.refresh()

        try:
            self.api.getDevice().pingHost(host, 700, done)
        except Exception:
            self.active -= 1
            self.completed += 1
            self.launch_next()

    def stop_scan(self):
        if self.scanning:
            self.scanning = False
            self.queue = []
            self.status = "Scan stopped · " + str(len(self.hosts)) + " live hosts"
            self.refresh()

    def host_callback(self, host):
        def callback(value=None):
            self.selected = host
            self.navigate("host")

        return callback

    def scan_ports(self, host):
        def done(payload):
            try:
                result = json.loads(str(payload))
            except Exception:
                result = {}
            self.ports[host] = result
            self.status = "Port scan finished for " + host
            self.refresh()

        self.status = "Scanning " + str(len(PORTS)) + " ports on " + host
        self.refresh()
        try:
            self.api.getDevice().portScan(host, PORTS, 500, done)
        except Exception:
            self.status = "Port scan failed"

    def screen_main(self, ui, api, state):
        try:
            network = json.loads(str(self.api.getDevice().networkActiveJson()))
        except Exception:
            network = {}
        rows = []
        for host in sorted(self.hosts.keys(), key=lambda item: int(item.rsplit(".", 1)[-1])):
            result = self.hosts[host]
            rows.append(
                ui.function_row(
                    host,
                    "reply in " + str(result.get("ms", "?")) + " ms",
                    "computer",
                    on_click=self.host_callback(host),
                )
            )
        if not rows:
            rows = [
                ui.card(
                    [
                        ui.icon("lan", 42),
                        ui.text("No live hosts yet", "titleMedium"),
                        ui.text("Start a sweep over the local subnet. Some devices ignore ICMP requests.", "bodyMedium"),
                    ]
                )
            ]
        return ui.scaffold(
            title="LAN Scanner",
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.row(
                                [
                                    ui.icon("lan", 36),
                                    ui.column(
                                        [
                                            ui.text("Local network", "titleLarge"),
                                            ui.text("Ping sweep and TCP port discovery", "bodySmall"),
                                        ],
                                        spacing=2,
                                    ),
                                ],
                                spacing=12,
                            ),
                            ui.row(
                                [
                                    ui.chip("Internet" if network.get("hasInternet") else "No internet", bool(network.get("hasInternet"))),
                                    ui.chip("Wi-Fi" if network.get("wifi") else "Not Wi-Fi", bool(network.get("wifi"))),
                                    ui.chip("VPN" if network.get("vpn") else "No VPN", bool(network.get("vpn"))),
                                ],
                                spacing=6,
                            ),
                            ui.text_field(self.base, self.set_base, "Subnet prefix, for example 192.168.1."),
                            ui.text_field(self.range_text, self.set_range, "Host range, for example 1-64"),
                            ui.row(
                                [
                                    ui.button("Stop" if self.scanning else "Start sweep", self.toggle, fill_max_width=True),
                                    ui.button("Detect subnet", self.redetect, style="tonal", fill_max_width=True),
                                ],
                                spacing=8,
                            ),
                            ui.text(self.status, "bodySmall"),
                        ]
                    ),
                    ui.text("Live hosts (" + str(len(self.hosts)) + ")", "titleMedium"),
                    ui.segmented_list(rows),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )

    def toggle(self):
        if self.scanning:
            self.stop_scan()
        else:
            self.start_scan()

    def redetect(self):
        detected = self.detect_base()
        if detected:
            self.base = detected
            self.status = "Detected subnet " + detected + "0/24"
        else:
            self.status = "Could not detect the subnet, set it manually"
        self.refresh()

    def screen_host(self, ui, api, state):
        host = self.selected or ""
        result = self.ports.get(host) or {}
        opened = result.get("open", []) if isinstance(result.get("open", []), list) else []
        rows = [ui.settings_row("Open TCP port " + str(port), "accepted a connection", "link") for port in opened]
        if not rows:
            rows = [ui.text("No open ports detected yet", "bodyMedium")]
        return ui.scaffold(
            title=host,
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.icon("computer", 48),
                            ui.text(host, "headlineSmall"),
                            ui.text(str((self.hosts.get(host) or {}).get("ms", "?")) + " ms ping", "bodySmall"),
                            ui.button("Scan TCP ports", self.port_callback(host), fill_max_width=True),
                            ui.text(str(len(PORTS)) + " common ports · " + str(result.get("scanned", 0)) + " scanned", "bodySmall"),
                        ]
                    ),
                    ui.text("Open ports", "titleMedium"),
                    ui.segmented_list(rows),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )

    def port_callback(self, host):
        def callback(value=None):
            self.scan_ports(host)

        return callback
